# ==============================================================================
# CampusCare - Environment Configuration Template
# ==============================================================================
# Instructions for Team Members:
# 1. Copy this file to '.env':
#    cp .env.example .env (Linux/macOS) or Copy-Item .env.example .env (Windows PowerShell)
# 2. Fill in your Supabase project credentials below.
# 3. NEVER commit your actual '.env' file to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Cloud Database Configuration
# ------------------------------------------------------------------------------
# Obtain these from: Supabase Dashboard -> Project Settings -> API
# - VITE_SUPABASE_URL: Project URL (https://<project-ref>.supabase.co)
# - VITE_SUPABASE_ANON_KEY: Public Anonymous Key (safe for client-side use)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
